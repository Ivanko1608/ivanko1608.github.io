---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tags from '../../components/site/Tags.astro';
import { getPosts, fmtDate } from '../../posts';
import { hero } from '../../data';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: { '@type': 'Person', name: hero.name, url: Astro.site?.href },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  keywords: post.data.tags.join(', '),
};
---

<Base title={`${post.data.title} — Ivan Kramarenko`} description={post.data.description} type="article" jsonLd={jsonLd}>
  <article class="article">
    <a class="back" href="/blog/">← all posts</a>
    <h1>{post.data.title}</h1>
    <div class="meta">
      <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
      <Tags tags={post.data.tags.map((label) => ({ label, variant: 'rust' as const }))} />
    </div>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
