---
import type { Tag } from '../../data';

interface Props {
  tags: { label: string; variant?: Tag['variant'] }[];
}
const { tags } = Astro.props;
---

<div class="tags">
  {tags.map((t) => <span class:list={['tag', t.variant && t.variant !== 'default' && `tag-${t.variant}`]}>{t.label}</span>)}
</div>
